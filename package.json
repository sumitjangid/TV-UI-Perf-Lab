{
  "name": "tv-ui-perf-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "bench": "npm run generate:catalog && npm run build && tsx scripts/benchmark.ts",
    "analyze:experiment": "tsx scripts/analyze-experiment.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.1",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
